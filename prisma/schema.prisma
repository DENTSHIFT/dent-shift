// P0 vertical slice用の最小スキーマ。
// 開発中はSQLiteを使用(このサンドボックス環境ではネットワーク制限によりPostgresへの
// 接続確認ができないため)。本番はARCHITECTURE.md/DATA_MODEL.mdの方針どおり
// PostgreSQL(Neon/Supabase)+ Prisma を使用し、provider を "postgresql" に切り替える。
// SQLiteはJSON型を持たないため、構造化データは一旦Stringに直列化して保存している。
// Postgres移行時は該当フィールドをJson型に変更する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String      @id @default(cuid())
  name      String
  url       String
  gbpUrl    String?
  bookingUrl String?
  createdAt DateTime    @default(now())
  diagnoses Diagnosis[]
}

model Diagnosis {
  id               String   @id @default(cuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  totalPoints      Int
  totalStatus      String
  // 以下はJSON文字列として保存(SQLite制約。DATA_MODEL.md参照)
  scoreBreakdownJson String
  competitorsJson    String
  questionResultsJson String
  improvementTasksJson String
  dataDisclaimer   String
  measuredAt       DateTime @default(now())
}
