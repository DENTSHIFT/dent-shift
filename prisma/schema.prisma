// P0 vertical slice用の最小スキーマ。
// 開発中はSQLiteを使用(このサンドボックス環境ではネットワーク制限によりPostgresへの
// 接続確認ができないため)。本番はARCHITECTURE.md/DATA_MODEL.mdの方針どおり
// PostgreSQL(Neon/Supabase)+ Prisma を使用し、provider を "postgresql" に切り替える。
// SQLiteはJSON型を持たないため、構造化データは一旦Stringに直列化して保存している。
// Postgres移行時は該当フィールドをJson型に変更する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             String          @id @default(cuid())
  name           String
  // 院長名。Ver3.3仕様(2026-09-21)で無料診断フォームの必須項目に追加。
  // 既存行との互換性のためnullable。
  directorName   String?
  url            String
  // 医院の代表連絡先。患者個人情報ではない。無料診断結果メールの送信先として保持する。
  // 既存行との互換性を保つためnullableとし、新規診断・新規会員登録から保存する。
  contactEmail   String?
  // 医院の代表電話。患者個人情報ではない。既存行との互換性のためnullable。
  contactPhone   String?
  gbpUrl         String?
  bookingUrl     String?
  createdAt      DateTime        @default(now())
  diagnoses      Diagnosis[]
  contacts       Contact[]
  subscriptions  Subscription[]
  billingWebhookEvents BillingWebhookEvent[]
  // 2026-09-05: ai_observationsをdiagnosis単位だけでなくclinic単位でも
  // テナント分離して参照できるようにする(SECURITY.md「テナント分離の実装方針」)
  aiObservations AiObservation[]
  attribution    Attribution?

  // 2026-09-21: AI改善実行・オプション販売(仕様Ver1)。
  optionOrders        OptionOrder[]
  generatedArtifacts   GeneratedArtifact[]
  entitlementUsages    PlanEntitlementUsage[]
  clinicAuditLogs      ClinicAuditLog[]
  // 2026-09-22: 改善アクション4ルートの①自院で対応マーク。
  selfServeMarks       ImprovementActionSelfServeMark[]
}

model Diagnosis {
  id                   String   @id @default(cuid())
  clinicId             String
  clinic               Clinic   @relation(fields: [clinicId], references: [id])
  totalPoints          Int
  totalStatus          String
  // 以下はJSON文字列として保存(SQLite制約。DATA_MODEL.md参照)
  scoreBreakdownJson   String
  competitorsJson      String
  questionResultsJson  String
  improvementTasksJson String
  dataDisclaimer       String
  measuredAt           DateTime @default(now())
  // 診断結果メールは診断保存後に送信するため、診断自体の成功と分離して状態を保持する。
  // "pending" | "sent" | "failed" | "disabled"
  resultEmailStatus    String   @default("pending")
  resultEmailSentAt    DateTime?

  // 2026-09-05: 無料診断結果への正式統合(医療広告AIチェック結果の永続化)。
  // AdComplianceCheckResultを丸ごと保存する(findings[].sourceType/provisional/
  // sourceLabel/evidence[].sourceTypeを含む。既存の4列と同じJSON文字列パターン)。
  // 既存行への安全なマイグレーションのため空結果をデフォルト値にする。
  adComplianceChecksJson String @default("{\"findings\":[],\"disclaimer\":\"\",\"checkedAt\":\"\"}")

  // 2026-09-05: 診断行単位で「サンプル/mockデータを含むか」を機械的に判定できるようにする
  // (docs/DATA_MODEL.md正本の diagnoses.is_sample に対応)。criterion単位のdataSource・
  // ai_observationのdataSource・ad-compliance findingのsourceTypeのいずれかに"mock"が
  // 1件でも含まれていればtrue(runFreeDiagnosis.tsのcomputeIsSample()で機械的に算出する。
  // providerや呼び出し側が直接assertする値ではない)。既存行(P0はmockのみで運用してきた)
  // に対する安全なデフォルトとしてtrueにする。
  isSample Boolean @default(true)

  // 2026-09-05: AI別・質問別の生観測結果(「どのAIに・どの質問を投げ・自院/競合が
  // どう表示されたか」を後から説明・再現するため)。診断のJSON列に埋め込むのではなく、
  // 独立したテーブルとして保存する(ユーザー指示)。
  aiObservations AiObservation[]

  // 2026-09-21: この診断(report)を対象にしたオプション購入(制作会社向け修正指示書等)。
  // 改善タスク自体は永続化された行を持たない(Diagnosis.improvementTasksJson内のJSON)ため、
  // OptionOrder側はimprovementActionKeyを文字列として保持し、reportId=Diagnosis.idで紐付ける。
  optionOrders OptionOrder[]
  selfServeMarks ImprovementActionSelfServeMark[]
}

// 2026-09-05: AI別・質問別の生観測結果(無料診断結果への正式統合、ユーザー指示①)。
// 「どのAIに・どの質問を投げ・自院/競合がどう表示されたか」を後から説明・再現できることを
// 目的とする。患者個人情報は一切含めない(質問文・医院側の観測結果のみ)。
// 無制限な生レスポンスの保存はしない(evidenceは要約済みの文字列のみを保持する。
// ARCHITECTURE.md/DATA_MODEL.mdのai_observationsに対応するが、SQLite制約により
// citations/competitorsは配列をJSON文字列として保存する)。
model AiObservation {
  id              String   @id @default(cuid())
  diagnosisId     String
  diagnosis       Diagnosis @relation(fields: [diagnosisId], references: [id])
  // diagnosisId経由でも辿れるが、clinic単位のテナント分離クエリ・監査を
  // JOINなしで行えるようにするため直接持たせる(ユーザー指示)。
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  patientQuestion String
  provider        String // "chatgpt" | "gemini" (AiObservationResult.aiProvider)
  model           String
  // 2026-09-07: 実AI計測provider導入に向け、unavailable観測(provider障害等)を
  // 「非言及(false)」や「0件」と混同せず表現できるようnullable化した(ユーザー指示)。
  // 値が存在するのはmeasurementStatusが"measured"|"reference"の場合のみ。
  // "unavailable"の場合は必ずnullとし、非言及として扱わない。
  mention         Boolean?
  // 取得不能/非言及時はnull(0扱いにしない。DATA_MODEL.md ai_observations.recommendation_rank参照)
  rank            Int?
  // 2026-09-07: 同上の理由でnullable化。SQL NULL=未測定/unavailable、"[]"=測定して0件、
  // JSON配列=測定して値ありを区別する(ユーザー指示)。
  citationsJson   String?
  competitorsJson String?
  // 医院の商圏・エリア情報を収集する入力がP0にはまだ存在しないため常にnull
  region          String?
  // このai_observationが属する診断の測定時刻(Diagnosis.measuredAtと同一値)
  measurementAt   DateTime
  // このai_observation自体が取得された時刻(AiObservationResult.capturedAt)
  capturedAt      DateTime
  evidence        String
  // AiObservationResult.dataSource("mock"|"live")をそのまま保持する
  sourceType      String
  // 2026-09-07: 実AI計測provider導入の設計により追加(ユーザー承認済み設計書
  // docs/AI_MEASUREMENT_PROVIDER_DESIGN_2026-09-07.md参照)。
  // "measured" | "reference" | "unavailable" の3値のみを許容する(アプリ側でpure
  // validationを設け、DB制約だけに依存しない)。
  // phase1(nullableで追加し既存48行をbackfill)を経て、phase2としてNOT NULL化した。
  // 新規書き込みはsrc/server/db/diagnosisRepository.tsの
  // resolveMeasurementStatusForNewObservation()が必ずmeasurementStatusを決定するか、
  // (dataSource="live"のlegacy観測の場合)LegacyLiveAiObservationErrorをthrowして
  // 保存自体を拒否するため、null書き込み経路は存在しない。
  // 恒久的な@defaultは付与しない(新規ai_provider行の設定漏れを"型エラー"として
  // 検出できる状態を維持するため。@defaultを付けるとその検出力が失われる)。
  measurementStatus String
  // measurementStatus="unavailable"の時のみ非null。それ以外は必ずnull。
  unavailableReason String?
  // sourceType="ai_provider"の観測は原則必須(tool種別・実行された検索クエリ・
  // usage・フィールド単位のprovenance等を正規化して保持する。生レスポンスは保存しない)。
  // legacy行・既存mock/reference行に限りnullを許容する。
  measurementMetaJson String?
  // sourceType="mock"のときのみtrue。provider/呼び出し側が直接assertせず、
  // sourceTypeから機械的に導出する(ad-compliance findingのprovisionalと同じ原則)。
  // 2026-09-07: measurementStatus==="reference"の観測も含める(ユーザー指示)。
  // measurementStatus==="unavailable"の場合はfalseを格納するが、可用性判定は
  // 必ずmeasurementStatusを先に見ること(provisionalだけで判定しない)。
  provisional     Boolean
  createdAt       DateTime @default(now())

  // P0: 診断結果取得(diagnosisId単位)とclinic_idテナント分離クエリで
  // 頻繁に使用するためインデックスを追加する(2026-09-05のユーザー指示)。
  @@index([diagnosisId])
  @@index([clinicId])
}

// Step4: 認証・無料会員。医院側の「人」(院長・スタッフ・制作会社)。患者ではない。
// 患者個人情報(氏名・電話番号等)はこのモデルに一切含めない(DATA_MODEL.md参照)。
// 2026-09-20: 会員本人確認(SMS OTP・メール確認)のためphoneNumber等を追加。
// これは無料トライアル登録者(Contact=院長・スタッフ・制作会社)自身の連絡先であり、
// 上記の「患者個人情報を含めない」原則の対象外(患者の電話番号ではない)。
model Contact {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  email        String    @unique
  passwordHash String
  role         String    @default("owner") // "owner" | "staff" | "agency"
  createdAt    DateTime  @default(now())
  // 2026-09-23: 運営側のパイロット医院モニタリング一覧(/ops/invites)向け。
  // createSession()実行時(ログイン・サインアップ直後の自動ログイン含む)に更新する。
  lastLoginAt  DateTime?
  sessions     Session[]

  // 会員本人(Contact)のSMS OTP認証。E.164正規化して保存する。
  phoneNumber      String?
  phoneVerifiedAt  DateTime?
  // "pending" | "sent" | "verified" | "failed" | "locked"
  smsStatus        String?
  smsSentAt        DateTime?
  smsAttemptCount  Int       @default(0)
  smsResendCount   Int       @default(0)
  // 2026-09-24: Twilio Trust Hub審査停止等でSMS認証が利用できない個別医院向けの
  // 限定的な例外。運営が特定Contact行にのみ設定する(コード側でメール等をハードコード
  // しない)。true の場合、requireContact()のphoneVerifiedAt必須チェックと
  // /verify-phoneのSMSフォームをスキップし、registrationStepを"email"へ進める。
  smsVerificationExempt Boolean @default(false)

  passwordResetTokenHash          String?
  passwordResetExpiresAt          DateTime?
  passwordResetEmailRequestedAt   DateTime?
  passwordResetSmsSentAt          DateTime?
  passwordResetSmsWindowStartedAt DateTime?
  passwordResetSmsSendCount       Int       @default(0)
  passwordResetSmsAttemptCount    Int       @default(0)

  // 会員本人(Contact)のメールアドレス確認。トークン平文は保存せずハッシュのみ保持する。
  emailVerifiedAt             DateTime?
  emailVerificationTokenHash  String?
  emailVerificationExpiresAt  DateTime?

  // 登録途中離脱からの再開に使う進捗ステップ。
  // "profile" | "sms" | "email" | "payment" | "consent" | "completed"
  registrationStep   String    @default("profile")
  consentAcceptedAt  DateTime?

  // 2026-09-21: AI改善実行・オプション販売(仕様Ver1)。
  optionOrders    OptionOrder[]
  clinicAuditLogs ClinicAuditLog[]
  selfServeMarks  ImprovementActionSelfServeMark[]
  invitesUsed     Invite[]

  @@index([phoneNumber])
}

// サーバー側で失効管理する不透明トークン方式のセッション(JWT等の追加依存を増やさないため)。
model Session {
  token     String   @id
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Step5: 契約・決済。カード番号などの決済情報は保持せず、決済サービス側のIDだけを持つ。
model Subscription {
  id                     String    @id @default(cuid())
  clinicId               String
  clinic                 Clinic    @relation(fields: [clinicId], references: [id])
  plan                   String
  status                 String    @default("trial")
  externalSubscriptionId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  // Stripe通知の到着順が前後しても、古い状態で上書きしないための時刻。
  statusEventAt          DateTime?
  payments               Payment[]

  // 7日間無料トライアルの開始・終了予定日時。SMS・メール・決済方法・規約同意が
  // すべて揃うまでtrialStartedAtは設定しない(activateTrial.ts参照)。
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  // Stripeの決済方法登録状態("none" | "pending" | "completed" 等)。カード情報自体は保持しない。
  paymentMethodStatus    String?

  // 2026-09-22: 知人院長向け1円招待モニター経由で作成された契約かどうかの追跡用(任意)。
  // 通常契約はnull。招待経由のplanは常に"standard"(機能判定用。実際の請求は
  // Invite.stripePriceIdの別Priceを使うため、料金ロジックには一切影響しない)。
  inviteId               String?
  invite                 Invite?   @relation(fields: [inviteId], references: [id])

  // 2026-09-24: 永久無料の特別アカウント(例: 医院紹介者本人など)向け。
  // trueの場合、trialEndsAtは意図的にnull(期限なし)とし、将来実装される
  // trialEndsAt到達時の自動停止バッチ等の対象から明示的に除外する。
  // 通常のPilot(28日等の有期)・通常課金ユーザーには影響しない(既定false)。
  billingExempt          Boolean   @default(false)

  @@index([clinicId])
}

// Stripeから受け取った通知IDだけを保存し、同じ通知の再送を二重処理しない。
// カード情報や通知の生本文は保存しない。
model BillingWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  status          String
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id])
  occurredAt      DateTime
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([clinicId])
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  status            String
  externalPaymentId String?      @unique
  occurredAt        DateTime
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
}

// 2026-09-20: Salesforce CRM同期キュー(指示書9章「Salesforce同期方式」)。
// 内部DB更新をSalesforceへの外部API呼び出しに密結合させず、このテーブルを介して
// 非同期に同期する。Salesforceへ送ってはいけない値(OTP・認証トークン・Stripe Secret・
// カード情報・パスワードhash・セッション)はpayloadJsonに含めない(salesforceSync.ts参照)。
model IntegrationEvent {
  id           String    @id @default(cuid())
  // Salesforce側のLead/Contact等のRecord ID(取得後に保持する)。
  externalId   String?
  eventType    String
  // ホワイトリスト方式で組み立てた同期用データ(SQLite制約によりJSON文字列で保存)。
  payloadJson  String
  // "pending" | "processing" | "synced" | "failed"
  status       String    @default("pending")
  retryCount   Int       @default(0)
  lastError    String?
  contactId    String?
  clinicId     String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
  // 2026-09-24: ops再送管理画面の「最終試行日時」表示用。同期を試行するたび
  // (成功/失敗いずれも)更新する。既存行はnull(過去分は表示上「—」扱い)。
  lastAttemptedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// 2026-09-20: Step8アンバサダー機能の最小実装(仮仕様)。
// 紹介報酬率・支払い条件は未確定のため、ここでは紹介コード発行と成果(attribution)の
// 状態追跡のみを行う。実際の報酬計算・支払い処理は含まない(IMPLEMENTATION_PLAN.md Step8参照)。
model Ambassador {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  referralCode String       @unique
  createdAt    DateTime     @default(now())
  attributions Attribution[]
}

// 紹介経由の医院登録を追跡する。成果(confirmed)は「有料契約+初回入金確定時点」のみで、
// 紹介コード入力(pending)だけでは成果化しない(ユーザー指示、IMPLEMENTATION_PLAN.md Step8)。
model Attribution {
  id           String     @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id])
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  // "pending" | "confirmed"
  status       String     @default("pending")
  referredAt   DateTime   @default(now())
  confirmedAt  DateTime?

  @@unique([clinicId])
  @@index([ambassadorId])
  @@index([status])
}

// 2026-09-20: 運営側(社内オペレーター)。医院側Contactとは完全に別の認証ドメインとする
// (SECURITY.md「認証ドメインを2系統に分ける」)。エンドユーザー向けセッションと混在させない。
// 自己サインアップは提供しない(社内で個別に発行する運用を想定、`scripts/`等でシード)。
model Operator {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  // "admin" | "cs" | "analyst" | "finance"
  role         String
  createdAt    DateTime          @default(now())
  sessions     OperatorSession[]
  auditLogs    AuditLog[]

  // 2026-09-23: パスワード再設定(forgot-password)用。平文トークンは一切保存しない
  // (sha256ハッシュのみ)。使用済み・期限切れ判定はAPI側で行い、成功後は両方nullに戻す。
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
}

// 医院側Sessionモデルと同型だが、テーブル・Cookie名を分離し、権限を混在させない。
model OperatorSession {
  token      String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// クロステナント参照・外部書き込みを伴う運営側操作の監査ログ(SECURITY.md F「外部書き込みの
// 人承認ゲート」)。実行内容の diff 等はmetadataJsonへ構造化して保存する(SQLite制約により文字列化)。
model AuditLog {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// 2026-09-21: DENT SHIFT AI改善実行・オプション販売仕様 Ver1
// 「診断・提案だけで終わるSaaS」から「AI改善実行→医院承認→対応→再診断」まで
// 回すプロダクトへの拡張。まず確定商品「制作会社向け修正指示書」(3,300円/1件)のみ対象。
// 指示書以外のオプション商品名・価格は未確定のため、それらを前提にした列は追加しない。
// ============================================================================

// 販売可能なAIオプション商品のマスター。価格・Stripe参照をコードへハードコードしない
// (billingConfig.tsと同じ方針)。keyはコード側から安定して参照するための識別子。
model OptionProduct {
  id           String   @id @default(cuid())
  key          String   @unique // 例: "instruction_pdf"
  name         String
  description  String?
  active       Boolean  @default(true)
  // 成果物の種別。現時点では"pdf"のみ。将来の他成果物追加を見込んで文字列にする。
  deliveryType String
  priceJpy     Int
  currency     String   @default("jpy")
  // Stripe側のProduct/Price ID。作成前(未確定商品)はnullを許容する。
  stripeProductId String?
  stripePriceId   String?
  requiresPayment                 Boolean @default(true)
  requiresHumanReview             Boolean @default(false)
  requiresExplicitPublishApproval Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders OptionOrder[]
}

// オプション商品の注文(購入)。無料枠内の場合もincluded=trueのレコードを必ず作り、
// 監査可能にする(仕様書■6「無料枠も利用レコードを作り...」)。
// reportId×version×productKeyの組で一意にし、再試行(生成失敗からの再生成)は
// 新しい注文を作らずこの行の状態を進める(二重課金・二重生成の防止)。
model OptionOrder {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  productId  String
  product    OptionProduct @relation(fields: [productId], references: [id])
  // 監査・冪等性チェックをJOINなしで行うための非正規化コピー。
  productKey String

  // 改善タスクは永続化された行を持たないため、識別子(ImprovementCandidate.key)を
  // 文字列として保持する(FKなし)。
  improvementActionKey String?

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)

  // draft→preview_ready→payment_required/included→checkout_created→payment_pending
  // →paid→generation_queued→generating→generated→available→downloaded→completed
  // →remeasurement_pending→remeasured
  // 例外: payment_failed / generation_failed / refunded / cancelled / expired
  status String @default("draft")

  // プラン無料枠を消費した注文かどうか。trueの場合amountJpyは0。
  includedByPlan Boolean @default(false)
  amountJpy      Int     @default(0)
  currency       String  @default("jpy")

  // 注文時点のプラン・価格のスナップショット(後日プラン変更・値上げがあっても
  // 過去注文の表示が変わらないようにする)。
  planSnapshot  String?
  priceSnapshot Int?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  refundedAt  DateTime?

  artifact GeneratedArtifact?

  @@unique([reportId, version, productKey])
  @@index([clinicId])
  @@index([status])
}

// 生成された成果物(制作会社向け修正指示書PDF等)。
// パスワードは平文保存禁止。passwordHashは照合用(ログイン等と同じ一方向ハッシュ)、
// passwordEncryptedはダッシュボード再表示用(アプリ側の暗号鍵で可逆暗号化)に役割を分離する。
// 暗号鍵自体はこのテーブル・DBに一切保存しない(環境変数で管理)。
model GeneratedArtifact {
  id      String      @id @default(cuid())
  orderId String      @unique
  order   OptionOrder @relation(fields: [orderId], references: [id])
  clinicId String
  clinic   Clinic     @relation(fields: [clinicId], references: [id])

  type     String // 例: "instruction_pdf"
  reportId String
  version  Int

  // "pending" | "generating" | "generated" | "failed"
  generationStatus String @default("pending")
  // ファイル本体の保存先参照(将来オブジェクトストレージへ切り出す場合のキー等)。恒久公開URLではない。
  storageRef String?
  // Phase4時点ではオブジェクトストレージを新設せず、パスワード保護済みPDFの
  // バイト列をDBへ直接保存する(認可付きAPI経由でのみ読み出し、公開URLは発行しない)。
  fileData Bytes?

  // 照合用(パスワード入力時の検証にのみ使う。復元不可能な一方向ハッシュ)。
  passwordHash String?
  // 再表示用(アプリ側の暗号鍵で暗号化した値。ダッシュボードの「パスワードを表示」で復号する)。
  passwordEncrypted String?

  generatedAt   DateTime?
  expiresAt     DateTime?
  downloadedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clinicId])
}

// 改善アクション4ルート(①自院で対応/②制作会社/③アップグレード/④DENT SHIFT相談)のうち、
// ①のみ決済・生成を伴わない「医院自身が対応することにした」という単純な意思表示のため、
// OptionOrder等とは別の軽量なマークとして持つ(2026-09-22)。取り消し可能なようDELETEで
// 行ごと削除する(状態機械は持たない。「マークされているか否か」の2値のみ)。
model ImprovementActionSelfServeMark {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)
  // ImprovementCandidate.key(永続化された行を持たないため文字列参照)。
  improvementActionKey String

  markedAt DateTime @default(now())

  @@unique([reportId, version, improvementActionKey])
  @@index([clinicId])
}

// プラン別の月次無料枠(Entitlement)の消費状況。Stripeに0円商品を作らず、
// ここで無料枠判定・消費を行う(仕様書■方針)。同時リクエストでの二重消費を防ぐため、
// 消費はDBトランザクション内で「usedQuantity < includedQuantity」を条件にした
// 条件付きUPDATEで行う(アプリ側ロジック、entitlementRepository.ts参照)。
model PlanEntitlementUsage {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // 例: "instruction_pdf_monthly"
  entitlementKey   String
  // 月次枠のキー(例: "2026-09")。
  period           String
  includedQuantity Int
  usedQuantity     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, entitlementKey, period])
}

// 医院側(Contact)が行った、オプション購入・生成・ダウンロードの監査ログ。
// 既存のAuditLog(運営者Operator専用、クロステナント操作向け)とは責務が異なるため分離する。
model ClinicAuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // 例: "option_order_created" | "option_paid" | "artifact_generated" |
  //     "artifact_generation_failed" | "artifact_downloaded"
  action       String
  targetType   String // "OptionOrder" | "GeneratedArtifact"
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([clinicId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 2026-09-22: 知人院長向け「1円モニター利用」専用招待。通常のプラン・料金表・
// Stripe Priceとは完全に分離する(通常LP/料金表には一切出さず、
// `/invite/{inviteCode}` 経由でのみ到達させる)。将来的にDoctorbook限定・提携先限定
// 等の別キャンペーンにも流用できるよう、汎用的なフィールド構成にしている。
model Invite {
  id         String  @id @default(cuid())
  inviteCode String  @unique

  // 表示・運営者の管理用情報(実在Clinicとの紐付けは招待時点では行わない。
  // 対象医院はまだ会員登録していない前提のため)。
  clinicName String
  email      String
  // 2026-09-24: 招待ページで「医院名」ではなく実際の個人名(院長・理事長名)を
  // 出したいケース(木村正人からの個別招待等)のための任意項目。未入力ならnull。
  directorName String?

  specialPriceJpy Int    @default(1)
  durationMonths  Int    @default(3)
  // 招待専用Price(通常のSTRIPE_PRICE_ID_STANDARD等とは別のPrice ID)。
  stripePriceId   String

  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  usedAt    DateTime?
  usedByContactId String?
  usedByContact   Contact? @relation(fields: [usedByContactId], references: [id])

  // 登録メールアドレスと招待メールアドレスの一致を必須にするかどうか
  // (URL転送による不正利用対策。デフォルトtrue)。
  requireEmailMatch Boolean @default(true)

  // 流入元・施策区分の記録用(Pilot/通常招待を問わず自由記述)。
  // 例: "founder-monitor" | "doctorbook" | "direct" | "partner"
  // Pilot判定にはこのフィールドを使わない(isPilotを参照する)。
  campaign String?
  // "active" | "used" | "expired" | "revoked"
  status   String  @default("active")

  // 2026-09-24: Pilot判定を明示的なフラグに分離(以前はcampaign==="pilot"で判定していたが、
  // campaignを流入元記録用に自由に使えるようにするため)。
  isPilot Boolean @default(false)

  // 2026-09-23: パイロット先行利用(isPilot===true)専用。durationMonths(月単位)
  // では2〜4週間のような短い試用期間を表現できないため、日数単位の上書きを別途持つ。
  // 非pilot招待では常にnull(durationMonthsによる従来計算のまま)。
  // isLifetimeFree===trueの招待では無視する(期限なしのため)。
  pilotDurationDays Int?

  // 2026-09-24: 永久無料の特別アカウント発行用(例: 医院紹介者本人など)。
  // isPilot===trueの招待でのみ指定可能(Stripeを呼ばない同じ有効化経路を使うため)。
  // trueの場合、pilotDurationDaysは無視され、activatePilotInviteはtrialEndsAtをnull
  // (期限なし)・Subscription.billingExemptをtrueにして作成する。
  // 通常のPilot(28日等)・通常課金招待には一切影響しない(既定false)。
  isLifetimeFree Boolean @default(false)

  createdByOperatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([status])
  @@index([email])
}
