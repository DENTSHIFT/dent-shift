// Vercelのテスト・本番環境専用スキーマ。
// ローカル開発は ../schema.prisma (SQLite) を使い続ける。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             String          @id @default(cuid())
  name           String
  directorName   String?
  url            String
  contactEmail   String?
  contactPhone   String?
  gbpUrl         String?
  bookingUrl     String?
  createdAt      DateTime        @default(now())
  diagnoses      Diagnosis[]
  contacts       Contact[]
  subscriptions  Subscription[]
  billingWebhookEvents BillingWebhookEvent[]
  aiObservations AiObservation[]
  attribution    Attribution?

  optionOrders        OptionOrder[]
  generatedArtifacts   GeneratedArtifact[]
  entitlementUsages    PlanEntitlementUsage[]
  clinicAuditLogs      ClinicAuditLog[]
  selfServeMarks       ImprovementActionSelfServeMark[]
}

model Diagnosis {
  id                     String          @id @default(cuid())
  clinicId               String
  clinic                 Clinic          @relation(fields: [clinicId], references: [id])
  totalPoints            Int
  totalStatus            String
  scoreBreakdownJson     String
  competitorsJson        String
  questionResultsJson    String
  improvementTasksJson   String
  dataDisclaimer         String
  measuredAt             DateTime        @default(now())
  resultEmailStatus      String          @default("pending")
  resultEmailSentAt      DateTime?
  adComplianceChecksJson String          @default("{\"findings\":[],\"disclaimer\":\"\",\"checkedAt\":\"\"}")
  isSample               Boolean         @default(true)
  aiObservations         AiObservation[]
  optionOrders           OptionOrder[]
  selfServeMarks         ImprovementActionSelfServeMark[]
}

model AiObservation {
  id                  String    @id @default(cuid())
  diagnosisId         String
  diagnosis           Diagnosis @relation(fields: [diagnosisId], references: [id])
  clinicId            String
  clinic              Clinic    @relation(fields: [clinicId], references: [id])
  patientQuestion     String
  provider            String
  model               String
  mention             Boolean?
  rank                Int?
  citationsJson       String?
  competitorsJson     String?
  region              String?
  measurementAt       DateTime
  capturedAt          DateTime
  evidence            String
  sourceType          String
  measurementStatus   String
  unavailableReason   String?
  measurementMetaJson String?
  provisional         Boolean
  createdAt           DateTime  @default(now())

  @@index([diagnosisId])
  @@index([clinicId])
}

model Contact {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  email        String    @unique
  passwordHash String
  role         String    @default("owner")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]

  phoneNumber      String?
  phoneVerifiedAt  DateTime?
  smsStatus        String?
  smsSentAt        DateTime?
  smsAttemptCount  Int       @default(0)
  smsResendCount   Int       @default(0)

  emailVerifiedAt             DateTime?
  emailVerificationTokenHash  String?
  emailVerificationExpiresAt  DateTime?

  registrationStep   String    @default("profile")
  consentAcceptedAt  DateTime?

  optionOrders    OptionOrder[]
  clinicAuditLogs ClinicAuditLog[]
  selfServeMarks  ImprovementActionSelfServeMark[]
  invitesUsed     Invite[]

  @@index([phoneNumber])
}

model Session {
  token     String   @id
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id                     String    @id @default(cuid())
  clinicId               String
  clinic                 Clinic    @relation(fields: [clinicId], references: [id])
  plan                   String
  status                 String    @default("trial")
  externalSubscriptionId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  statusEventAt          DateTime?
  payments               Payment[]

  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  paymentMethodStatus    String?

  inviteId               String?
  invite                 Invite?   @relation(fields: [inviteId], references: [id])

  @@index([clinicId])
}

model BillingWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  status          String
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id])
  occurredAt      DateTime
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([clinicId])
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  status            String
  externalPaymentId String?      @unique
  occurredAt        DateTime
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
}

model IntegrationEvent {
  id           String    @id @default(cuid())
  externalId   String?
  eventType    String
  payloadJson  String
  status       String    @default("pending")
  retryCount   Int       @default(0)
  lastError    String?
  contactId    String?
  clinicId     String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model Ambassador {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  referralCode String       @unique
  createdAt    DateTime     @default(now())
  attributions Attribution[]
}

model Attribution {
  id           String     @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id])
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  status       String     @default("pending")
  referredAt   DateTime   @default(now())
  confirmedAt  DateTime?

  @@unique([clinicId])
  @@index([ambassadorId])
  @@index([status])
}

model Operator {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  role         String
  createdAt    DateTime          @default(now())
  sessions     OperatorSession[]
  auditLogs    AuditLog[]

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
}

model OperatorSession {
  token      String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// 2026-09-21: DENT SHIFT AI改善実行・オプション販売仕様 Ver1(SQLite版schema.prismaと同型)
// ============================================================================

model OptionProduct {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  deliveryType String
  priceJpy     Int
  currency     String   @default("jpy")
  stripeProductId String?
  stripePriceId   String?
  requiresPayment                 Boolean @default(true)
  requiresHumanReview             Boolean @default(false)
  requiresExplicitPublishApproval Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders OptionOrder[]
}

model OptionOrder {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  productId  String
  product    OptionProduct @relation(fields: [productId], references: [id])
  productKey String

  improvementActionKey String?

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)

  status String @default("draft")

  includedByPlan Boolean @default(false)
  amountJpy      Int     @default(0)
  currency       String  @default("jpy")

  planSnapshot  String?
  priceSnapshot Int?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  refundedAt  DateTime?

  artifact GeneratedArtifact?

  @@unique([reportId, version, productKey])
  @@index([clinicId])
  @@index([status])
}

model GeneratedArtifact {
  id      String      @id @default(cuid())
  orderId String      @unique
  order   OptionOrder @relation(fields: [orderId], references: [id])
  clinicId String
  clinic   Clinic     @relation(fields: [clinicId], references: [id])

  type     String
  reportId String
  version  Int

  generationStatus String @default("pending")
  storageRef String?
  fileData Bytes?

  passwordHash String?
  passwordEncrypted String?

  generatedAt   DateTime?
  expiresAt     DateTime?
  downloadedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clinicId])
}

model ImprovementActionSelfServeMark {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)
  improvementActionKey String

  markedAt DateTime @default(now())

  @@unique([reportId, version, improvementActionKey])
  @@index([clinicId])
}

model PlanEntitlementUsage {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  entitlementKey   String
  period           String
  includedQuantity Int
  usedQuantity     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, entitlementKey, period])
}

model ClinicAuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([clinicId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Invite {
  id         String  @id @default(cuid())
  inviteCode String  @unique

  clinicName String
  email      String

  specialPriceJpy Int    @default(1)
  durationMonths  Int    @default(3)
  stripePriceId   String

  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  usedAt    DateTime?
  usedByContactId String?
  usedByContact   Contact? @relation(fields: [usedByContactId], references: [id])

  requireEmailMatch Boolean @default(true)

  // 流入元・施策区分の記録用(Pilot/通常招待を問わず自由記述)。
  // 例: "founder-monitor" | "doctorbook" | "direct" | "partner"
  // Pilot判定にはこのフィールドを使わない(isPilotを参照する)。
  campaign String?
  status   String  @default("active")

  // 2026-09-24: Pilot判定を明示的なフラグに分離(以前はcampaign==="pilot"で判定していたが、
  // campaignを流入元記録用に自由に使えるようにするため)。
  isPilot Boolean @default(false)

  pilotDurationDays Int?

  createdByOperatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([status])
  @@index([email])
}
