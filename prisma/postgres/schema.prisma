// Vercelのテスト・本番環境専用スキーマ。
// ローカル開発は ../schema.prisma (SQLite) を使い続ける。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id             String          @id @default(cuid())
  name           String
  directorName   String?
  url            String
  contactEmail   String?
  contactPhone   String?
  gbpUrl         String?
  bookingUrl     String?
  createdAt      DateTime        @default(now())
  diagnoses      Diagnosis[]
  contacts       Contact[]
  subscriptions  Subscription[]
  billingWebhookEvents BillingWebhookEvent[]
  aiObservations AiObservation[]
  attribution    Attribution?

  optionOrders        OptionOrder[]
  generatedArtifacts   GeneratedArtifact[]
  entitlementUsages    PlanEntitlementUsage[]
  clinicAuditLogs      ClinicAuditLog[]
  selfServeMarks       ImprovementActionSelfServeMark[]
  trialEntitlements    TrialEntitlement[]

  // 2026-09-27追加(PO承認、P0): 無料トライアルを実際に開始した確定日時(Stripe
  // WebhookでSubscription.statusが実際に"trial"へ遷移した瞬間のみ設定、
  // billingRepository.ts参照)。null→非nullの一方向のみで、Checkout作成時点では
  // 設定しない(TrialEntitlement側の予約状態と役割を分離する)。
  trialConsumedAt DateTime?

  // 2026-09-29追加(PO承認、Salesforce連携P0): 初回流入時のUTMを医院単位で永続化する
  // (first-touch attribution)。一度nullでない値が設定された列は二度と上書きしない。
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
}

// 2026-09-27追加(PO承認、P0): 無料トライアルの「予約→消費/解放」ライフサイクルを
// 医院単位で管理する。Clinic.trialConsumedAtが恒久的な正本(消費済みかどうか)を
// 保持するのに対し、このテーブルは実際の遷移過程(Checkout試行ごとの1行)を保持する
// 監査ログの役割を持つ。
model TrialEntitlement {
  id     String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // "reserved" | "consumed" | "released"。他の値は既存のSubscriptionStatus等と同じ方針
  // (SQLite/Postgres両対応のためPrisma純正enumではなくString+アプリ側検証関数を使う)で
  // 許可し、Postgres側にはCHECK制約(migration SQLで追加)も設ける。
  status String @default("reserved")

  reservedAt           DateTime  @default(now())
  reservationExpiresAt DateTime
  checkoutSessionId    String?   @unique
  externalSubscriptionId String? @unique
  // 2026-09-27追加(PO承認、P0-Checkout接続): Checkout Session作成処理の「所有者」を
  // 識別する推測困難な一時トークン。reserveTrialEntitlement()呼び出しごとに新規生成し、
  // 以降のattach/release更新はこのトークンとの一致を条件にする(WHERE句に含める)ことで、
  // 別リクエストが同じ予約行を誤って更新・解放できないようにする(trialEntitlementRepository.ts参照)。
  reservationOwnerToken String?
  consumedAt           DateTime?
  releasedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model Diagnosis {
  id                     String          @id @default(cuid())
  clinicId               String
  clinic                 Clinic          @relation(fields: [clinicId], references: [id])
  totalPoints            Int
  totalStatus            String
  scoreBreakdownJson     String
  competitorsJson        String
  questionResultsJson    String
  improvementTasksJson   String
  dataDisclaimer         String
  measuredAt             DateTime        @default(now())
  resultEmailStatus      String          @default("pending")
  resultEmailSentAt      DateTime?
  adComplianceChecksJson String          @default("{\"findings\":[],\"disclaimer\":\"\",\"checkedAt\":\"\"}")
  isSample               Boolean         @default(true)
  aiObservations         AiObservation[]
  optionOrders           OptionOrder[]
  selfServeMarks         ImprovementActionSelfServeMark[]
}

model AiObservation {
  id                  String    @id @default(cuid())
  diagnosisId         String
  diagnosis           Diagnosis @relation(fields: [diagnosisId], references: [id])
  clinicId            String
  clinic              Clinic    @relation(fields: [clinicId], references: [id])
  patientQuestion     String
  provider            String
  model               String
  mention             Boolean?
  rank                Int?
  citationsJson       String?
  competitorsJson     String?
  region              String?
  measurementAt       DateTime
  capturedAt          DateTime
  evidence            String
  sourceType          String
  measurementStatus   String
  unavailableReason   String?
  measurementMetaJson String?
  provisional         Boolean
  createdAt           DateTime  @default(now())

  @@index([diagnosisId])
  @@index([clinicId])
}

model Contact {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  email        String    @unique
  passwordHash String
  role         String    @default("owner")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]

  phoneNumber      String?
  phoneVerifiedAt  DateTime?
  smsStatus        String?
  smsSentAt        DateTime?
  smsAttemptCount  Int       @default(0)
  smsResendCount   Int       @default(0)
  smsVerificationExempt Boolean @default(false)

  passwordResetTokenHash          String?
  passwordResetExpiresAt          DateTime?
  passwordResetEmailRequestedAt   DateTime?
  passwordResetSmsSentAt          DateTime?
  passwordResetSmsWindowStartedAt DateTime?
  passwordResetSmsSendCount       Int       @default(0)
  passwordResetSmsAttemptCount    Int       @default(0)

  emailVerifiedAt             DateTime?
  emailVerificationTokenHash  String?
  emailVerificationExpiresAt  DateTime?

  registrationStep   String    @default("profile")
  consentAcceptedAt  DateTime?

  optionOrders    OptionOrder[]
  clinicAuditLogs ClinicAuditLog[]
  selfServeMarks  ImprovementActionSelfServeMark[]
  invitesUsed     Invite[]

  @@index([phoneNumber])
}

model Session {
  token     String   @id
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id                     String    @id @default(cuid())
  clinicId               String
  clinic                 Clinic    @relation(fields: [clinicId], references: [id])
  plan                   String
  status                 String    @default("trial")
  externalSubscriptionId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  statusEventAt          DateTime?
  payments               Payment[]

  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  paymentMethodStatus    String?

  inviteId               String?
  invite                 Invite?   @relation(fields: [inviteId], references: [id])

  // 2026-09-24: 永久無料の特別アカウント向け。trueの場合trialEndsAtはnull(期限なし)、
  // 将来の自動停止対象から除外する。通常のPilot・通常課金には影響しない(既定false)。
  billingExempt          Boolean   @default(false)

  @@index([clinicId])
}

model BillingWebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  status          String
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id])
  occurredAt      DateTime
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([clinicId])
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  status            String
  externalPaymentId String?      @unique
  occurredAt        DateTime
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
}

model IntegrationEvent {
  id           String    @id @default(cuid())
  externalId   String?
  eventType    String
  payloadJson  String
  status       String    @default("pending")
  retryCount   Int       @default(0)
  lastError    String?
  contactId    String?
  clinicId     String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
  lastAttemptedAt DateTime?
  // 2026-09-29追加(PO承認、Salesforce連携P0): 指数バックオフの次回実行予定時刻。
  nextRetryAt DateTime?

  // 2026-09-28追加(PO再指摘、P0-Checkout接続): 「同じ実世界の出来事」を表すイベントの
  // 重複記録を防ぐための冪等キー。例: "trial_activated:<externalSubscriptionId>"。
  // trial_activatedはStripe Webhookの2つの独立した経路(TrialEntitlement消費確定/
  // Subscription状態遷移検知)のどちらが先に到達しても、DBのユニーク制約により
  // 最終的に1件だけになることを保証する(enqueueIntegrationEvent参照)。
  // dedupeKeyを使わない既存イベント種別は従来どおりnullのまま。
  dedupeKey String? @unique

  @@index([status])
  @@index([createdAt])
}

model Ambassador {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  referralCode String       @unique
  createdAt    DateTime     @default(now())
  attributions Attribution[]
}

model Attribution {
  id           String     @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id])
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  status       String     @default("pending")
  referredAt   DateTime   @default(now())
  confirmedAt  DateTime?

  @@unique([clinicId])
  @@index([ambassadorId])
  @@index([status])
}

model Operator {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  role         String
  createdAt    DateTime          @default(now())
  sessions     OperatorSession[]
  auditLogs    AuditLog[]

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
}

model OperatorSession {
  token      String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// 2026-09-21: DENT SHIFT AI改善実行・オプション販売仕様 Ver1(SQLite版schema.prismaと同型)
// ============================================================================

model OptionProduct {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  deliveryType String
  priceJpy     Int
  currency     String   @default("jpy")
  stripeProductId String?
  stripePriceId   String?
  requiresPayment                 Boolean @default(true)
  requiresHumanReview             Boolean @default(false)
  requiresExplicitPublishApproval Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders OptionOrder[]
}

model OptionOrder {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  productId  String
  product    OptionProduct @relation(fields: [productId], references: [id])
  productKey String

  improvementActionKey String?

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)

  status String @default("draft")

  includedByPlan Boolean @default(false)
  amountJpy      Int     @default(0)
  currency       String  @default("jpy")

  planSnapshot  String?
  priceSnapshot Int?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  refundedAt  DateTime?

  artifact GeneratedArtifact?

  @@unique([reportId, version, productKey])
  @@index([clinicId])
  @@index([status])
}

model GeneratedArtifact {
  id      String      @id @default(cuid())
  orderId String      @unique
  order   OptionOrder @relation(fields: [orderId], references: [id])
  clinicId String
  clinic   Clinic     @relation(fields: [clinicId], references: [id])

  type     String
  reportId String
  version  Int

  generationStatus String @default("pending")
  storageRef String?
  fileData Bytes?

  passwordHash String?
  passwordEncrypted String?

  generatedAt   DateTime?
  expiresAt     DateTime?
  downloadedAt  DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clinicId])
}

model ImprovementActionSelfServeMark {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  reportId String
  report   Diagnosis @relation(fields: [reportId], references: [id])
  version  Int       @default(1)
  improvementActionKey String

  markedAt DateTime @default(now())

  @@unique([reportId, version, improvementActionKey])
  @@index([clinicId])
}

model PlanEntitlementUsage {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  entitlementKey   String
  period           String
  includedQuantity Int
  usedQuantity     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, entitlementKey, period])
}

model ClinicAuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([clinicId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Invite {
  id         String  @id @default(cuid())
  inviteCode String  @unique

  clinicName String
  email      String
  // 2026-09-24: 招待ページで「医院名」ではなく実際の個人名(院長・理事長名)を
  // 出したいケース(木村正人からの個別招待等)のための任意項目。未入力ならnull。
  directorName String?

  specialPriceJpy Int    @default(1)
  durationMonths  Int    @default(3)
  stripePriceId   String

  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  usedAt    DateTime?
  usedByContactId String?
  usedByContact   Contact? @relation(fields: [usedByContactId], references: [id])

  requireEmailMatch Boolean @default(true)

  // 流入元・施策区分の記録用(Pilot/通常招待を問わず自由記述)。
  // 例: "founder-monitor" | "doctorbook" | "direct" | "partner"
  // Pilot判定にはこのフィールドを使わない(isPilotを参照する)。
  campaign String?
  status   String  @default("active")

  // 2026-09-24: Pilot判定を明示的なフラグに分離(以前はcampaign==="pilot"で判定していたが、
  // campaignを流入元記録用に自由に使えるようにするため)。
  isPilot Boolean @default(false)

  // isLifetimeFree===trueの招待では無視する(期限なしのため)。
  pilotDurationDays Int?

  // 2026-09-24: 永久無料の特別アカウント発行用。isPilot===trueの招待でのみ指定可能。
  // trueの場合、pilotDurationDaysは無視され、Subscription.billingExemptがtrueになる。
  isLifetimeFree Boolean @default(false)

  createdByOperatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([status])
  @@index([email])
}

// 2026-09-29追加(PO承認、再診断ループの連続実行対策P0): 診断API(/api/diagnosis)を
// 外部AI呼び出し前にスコープ単位(IP/Clinic/Contact)で短時間窓レート制限するための状態。
// プラン別の無料/有料利用回数制限(PlanEntitlementUsage相当)とは別物で、こちらは
// 「連続実行・二重送信・同時実行の技術的な抑制」のみを目的とする。
// scopeType+scopeKeyの一意制約により、複数サーバーインスタンスからの同時アクセスでも
// 行ロック(SELECT ... FOR UPDATE、diagnosisRateLimitRepository.ts参照)で
// 排他制御できる。
model DiagnosisRateLimitState {
  id              String    @id @default(cuid())
  scopeType       String
  scopeKey        String
  windowStartedAt DateTime
  countInWindow   Int       @default(0)
  // 実行中のリクエストが1件でもあればnon-null。同一スコープの新規実行を一時的に防ぐ
  // (同時実行・二重クリック対策)。値はexecutionIdを発行した実行だけが解放できる
  // (誤って他の実行のロックを解除しないため)。
  inFlightSince   DateTime?
  executionId     String?
  updatedAt       DateTime  @updatedAt

  @@unique([scopeType, scopeKey])
}

// 2026-09-29追加(PO承認、再診断ループの連続実行対策P0): クライアントが発行した
// リクエスト単位の冪等性キー。タイムアウト後の再送・多重クリックで同じ
// clientRequestIdが再送された場合、外部AI呼び出しを再実行せず、進行中なら
// 待機案内、完了済みなら同じdiagnosisIdをそのまま返す。
model DiagnosisIdempotencyLock {
  clientRequestId String    @id
  status          String
  diagnosisId     String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  // 2026-09-29追加(PO指摘、冪等性の主体紐付け・同時実行の正確な引き継ぎP0):
  // このclientRequestIdを最初に使った主体(ログイン中はcontactId、匿名はIPハッシュ)。
  // 別の主体が同じclientRequestIdを送っても、他人の診断結果(diagnosisId)を
  // 取得できないようにする。
  principalKey    String    @default("")
  // 同じclientRequestIdで異なる入力(医院名・URL等)が送られた場合に拒否するための、
  // 初回リクエスト本文のハッシュ(SHA-256)。
  inputHash       String    @default("")
  // レート制限側のexecutionIdと同じ考え方。TTL経過による引き継ぎ後、古い実行の
  // 完了処理(markCompleted/markFailed)が新しい実行の状態を誤って上書きしないよう、
  // 発行元の実行だけが自分のexecutionIdで更新できるようにする。
  executionId     String?

  @@index([createdAt])
}
