# 開発用(SQLite)。ARCHITECTURE.mdのとおり本番はPostgreSQL(Neon/Supabase)に切り替える
DATABASE_URL="file:./dev.db"

# Vercelのテスト環境では上記を管理型PostgreSQLの接続URLへ置き換える。
# 値はVercelのEnvironment Variablesだけに保存し、Gitへ追加しない。
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 契約・決済。公開価格はsrc/domain/billing/planPricing.tsを唯一の情報源にする。
# Stripeを選ぶ場合は、公開価格と一致する3プランのStripe Price IDを設定する。
BILLING_PROVIDER=disabled
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_LIGHT=
# STRIPE_PRICE_ID_STANDARD=
# STRIPE_PRICE_ID_PREMIUM=
# STRIPE_TAX_RATE_ID=
# STRIPE_WEBHOOK_SECRET=

# 制作会社向け修正指示書(3,300円税込・one-time)。仕様書Ver1(2026-09-21)で
# 確定している唯一のオプション商品。指示書以外のオプション商品・価格は未確定のため
# ここへ追加しない。
# STRIPE_PRICE_ID_INSTRUCTION_PDF=

# 知人院長向け1円招待モニター(2026-09-22確定)。通常プランのPrice IDとは完全に分離する。
# 通常LP・料金表には表示せず、/invite/{code}(招待コード)経由でのみ到達する。
# STRIPE_PRICE_ID_INVITE_MONITOR=

# 知人院長向け「パイロット先行利用」(2026-09-22確定)。campaign==="pilot"のInviteのみ、
# Stripeを一切呼ばずにスタンダード相当を有効化するtest環境限定バイパス。
# "enabled"以外(未設定含む)は常に無効。dent-shift-productionには絶対に設定しない。
# PILOT_INVITE_MODE=disabled

# 生成PDF(制作会社向け修正指示書等)の閲覧パスワードを再表示用に可逆暗号化するための
# AES-256-GCM鍵。32byte(64桁hex)。`node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# 等で生成し、環境ごとに別の値を使う。鍵自体はDBへ保存しない。
# ARTIFACT_PASSWORD_ENC_KEY=

# 診断結果メール。メール基盤の最終選定前はdisabledのままにする。
# "resend"を選んだ場合のみ、下の3項目が必須。
RESULT_EMAIL_PROVIDER=disabled
# RESEND_API_KEY=
# RESULT_EMAIL_FROM="DENT SHIFT <diagnosis@example.com>"
# APP_BASE_URL=https://your-dent-shift.example.com

# メール確認・パスワード再設定リンクだけの任意ホスト上書き(通常は未設定でよい)。
# 特定ブランチのPreviewを検証しているQA担当者がリンクをたどっても、ブランチAliasへ
# 戻れる(ログイン状態を維持する)ようにするための設定。EMAIL_LINK_BASE_URLだけでは
# 採用されず、そのホスト名がEMAIL_LINK_ALLOWED_HOSTS(カンマ区切り)に含まれる場合の
# みAPP_BASE_URLの代わりに使う(HTTPSであること自体は許可リストにならない)。
# 対象ブランチのVercel Preview環境変数としてのみ設定し、本番(Production)には設定しない。
# EMAIL_LINK_BASE_URL=https://dent-shift-test-git-release-dashboard-navigat-f6a397-dentshift1.vercel.app
# EMAIL_LINK_ALLOWED_HOSTS=dent-shift-test-git-release-dashboard-navigat-f6a397-dentshift1.vercel.app

# 会員本人確認のSMS OTP。プロバイダー未確定(IVRyのOTP API可否を優先確認、指示書23章)
# につきdisabledのままにする。"twilio-verify"を仮実装として選んだ場合のみ下記3項目が必須。
SMS_PROVIDER=disabled
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Salesforce CRM同期(OAuth 2.0 Client Credentials Flow)。ローカル開発は必ずdisabledのまま
# にする(本番組織へ書き込まないため)。"salesforce"を選んだ場合のみ下記4項目が必須。
# 接続先は環境ごとに分ける: Production=本番組織、Preview=Sandbox(作成後)。
SALESFORCE_PROVIDER=disabled
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://login.salesforce.com   (Sandboxは https://test.salesforce.com)
# 接続先組織ID(00Dで始まる15/18桁)。トークン取得時に実際の組織と照合し、不一致なら一切同期しない。
# SALESFORCE_EXPECTED_ORG_ID=
# 段階的同期ガード(2026-10-03): 同期を許可する医院IDのカンマ区切り。未設定/空/不正=全件停止(送信しない)。
# "*" で全医院を許可。許可は医院単位(その医院の保留中イベント・新規イベントの両方に及ぶ)。
# SALESFORCE_SYNC_CLINIC_ALLOWLIST=
# 自動再試行の上限に達した同期失敗の通知先(RESULT_EMAIL_PROVIDER=resendの送信基盤を使う)。
# SALESFORCE_ALERT_EMAIL=
# 商談フェーズ名(組織の選択リスト値に合わせる)。進行中/受注/失注の3区分のみ。
# 受注=一度でもStripeで有料化した契約(後の解約でも受注のまま。解約は契約項目で管理)、
# 失注=有料化しないまま解約、進行中=それ以外。未設定時は下記の既定値。
# SALESFORCE_OPPORTUNITY_STAGE_OPEN=Qualification
# SALESFORCE_OPPORTUNITY_STAGE_WON=Closed Won
# SALESFORCE_OPPORTUNITY_STAGE_LOST=Closed Lost

# Salesforce再試行Cron(/api/internal/salesforce/retry、vercel.json)の認証用。
# Vercel上(Preview/Production)では必須。未設定だとCronエンドポイントは503で実行を拒否する。
# 認証チェックを省略できるのはローカル開発(VERCEL未設定)のみ。
# CRON_SECRET=

# 無料診断結果画面の「スペシャリストに相談する(45分)」CTAから遷移するTimeRex予約ページURL。
# 任意設定。未設定の場合、CTA自体を表示しない(壊れたリンクを出さないため)。
# 今回はTimeRex API連携は不要で、単なる外部リンクで十分(ユーザー指示)。
# 電話番号の必須入力は、TimeRex側の予約フォームでも設定すること。
# NEXT_PUBLIC_SPECIALIST_BOOKING_URL=https://timerex.net/s/your-page/xxxxxxxx

# TimeRexの予約通知Webhook(/api/webhooks/timerex)。TimeRexのチーム設定→連携→Webhookで
# 発行される「セキュリティトークン」(ヘッダー x-timerex-authorization)をそのまま設定する。
# 未設定の場合、Webhookエンドポイント自体を無効化する。
# TIMEREX_WEBHOOK_SECRET=
# 予約URLへ付ける医院参照(ds_ref)の署名鍵。TimeRexはこのクエリをWebhookのurl_paramsで返すため、
# メールアドレスに頼らず予約と医院を対応付けられる。未設定なら参照を付けない(会員メール一致のみ)。
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 等で生成する。
# TIMEREX_BOOKING_REF_SECRET=

# LINE WORKS(顧客コミュニケーション基盤。仕様書Ver3.3 6章、2026-09-21)。
# 開通・API仕様確定まで未設定でよい(disabled既定)。開通後、provider="lineworks"を
# 明示選択した場合だけ以下の値が必須になる(src/server/config/lineWorksConfig.ts)。
# LINE_WORKS_PROVIDER=lineworks
# LINE_WORKS_CLIENT_ID=
# LINE_WORKS_CLIENT_SECRET=
# LINE_WORKS_SERVICE_ACCOUNT=
# LINE_WORKS_PRIVATE_KEY=
# LINE_WORKS_BOT_ID=
# LINE_WORKS_BOT_SECRET=

# 診断結果画面の「お電話でのお問い合わせ」CTAに表示するDENT SHIFT側の電話受付番号
# (IVRy想定、指示書13章)。ユーザー起点の問い合わせのみに使う。未設定の場合、CTA自体を
# 表示しない。IVRyの着信・通話結果連携(API/Webhook)は契約・仕様確定後に別途実装する。
# NEXT_PUBLIC_SUPPORT_PHONE_NUMBER=0120-000-000

# ---------------------------------------------------------------------------
# AI計測provider選択(2026-09-08のユーザー指示: Phase 3、composition root接続)。
#
# canonical AI計測(src/domain/ai-measurement/)をどのproviderで行うかを明示的に
# 選択する。値は "mock" または "openai" のみ許可される。未設定・不正値のいずれの
# 場合もroute request時に明示的errorとなり、mockへのsilent fallbackは行わない
# (src/server/config/aiMeasurementConfig.ts参照)。
#
# - "mock": canonical AI計測provider自体を使わない(deps.aiMeasurementProvider=
#   undefined)。既存のlegacy mock診断(scoreBreakdown/aiObservations)は
#   このモードでも従来どおり動作する(P0案Bの前提: canonical計測はoverlayであり、
#   legacy mock providerを置き換えるものではない)。
# - "openai": OpenAI Responses API(Web Search)による実測をcanonical overlayとして
#   追加接続する。この場合OPENAI_API_KEY / OPENAI_AI_MEASUREMENT_MODELの両方が
#   必須(いずれか欠落でも明示error)。
AI_MEASUREMENT_PROVIDER=

# AI_MEASUREMENT_PROVIDER="openai"の場合のみ必須。OpenAI API key。
# server-onlyとして扱うこと(client bundleへ含めない。NEXT_PUBLIC_接頭辞は絶対に
# 付けないこと)。値はまだ設定しない(Phase 4の実API smoke test前にユーザー側で設定する)。
OPENAI_API_KEY=

# AI_MEASUREMENT_PROVIDER="openai"の場合のみ必須。OpenAI Responses APIへ渡す
# requested model名(例: gpt-5.1等、実際に使うモデルはユーザー側で選定する)。
# 未設定時にsilent defaultへフォールバックすることはしない(明示error)。
OPENAI_AI_MEASUREMENT_MODEL=

# ---------------------------------------------------------------------------
# Phase 4: OpenAI Responses API + Web Search 手動smoke test専用
# (scripts/openai-measurement-smoke.ts、"npm run smoke:openai-measurement"、
# 2026-09-08のユーザー指示)。
#
# このscriptはAI_MEASUREMENT_PROVIDERを読まない(production providerの切替とは
# 無関係に、OpenAI経路を直接1回だけ実行するため)。OPENAI_API_KEY /
# OPENAI_AI_MEASUREMENT_MODELは上記のPhase 3用の値をそのまま使う。
#
# 実在医院情報を人間が明示入力するため、production envとは別名にしている
# (promptへは渡さず、response後のmention/citation matchingにのみ使われる)。
SMOKE_CLINIC_NAME=
SMOKE_CLINIC_URL=
