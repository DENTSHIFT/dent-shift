# Stage 1(Sandbox検証)専用の接続情報。コピーして salesforce/.env.sandbox を作り、値は本人が入力する。
# salesforce/.env.sandbox はGitに含めない(.gitignore済み)。本番の接続アプリ・認証情報は使わない。
#
# Sandbox内だけに作成する外部クライアントアプリ(Client Credentials Flow)の値:
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# SandboxのMy Domain(例: https://<mydomain>--dsverify.sandbox.my.salesforce.com)
SALESFORCE_LOGIN_URL=
# Sandboxの組織ID(00Dで始まる18桁)。本番の組織IDを入れるとスクリプトは停止する。
SALESFORCE_EXPECTED_ORG_ID=
# 連携専用ユーザー(Sandboxのみ)の通知先メール
SANDBOX_INTEGRATION_USER_EMAIL=
