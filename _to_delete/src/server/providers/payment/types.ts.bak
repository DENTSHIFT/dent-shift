/**
 * 決済プロバイダーの抽象インターフェース(2026-09-06のユーザー指示: 契約フロー実装)。
 * DENT_SHIFT_CLAUDE_CODE_HANDOFF.md 36章「決済代行の最終確定」は未確定事項であり、
 * ユーザーは「Stripeを使う予定だが未契約」の状態。既存のsrc/server/providers/ai,
 * competitor, ad-compliance と同じ設計方針(mock実装のみ→後日実プロバイダーを
 * 追加実装し、サービス層/APIルートは一切変更しない)に揃える。
 *
 * 重要: このアプリはPCI準拠のカード情報保管を行わない(HANDOFF.md 35章「保存禁止データ」に
 * カード番号を明記)。生のカード番号・CVVを直接受け取るフィールドは存在せず、
 * 実プロバイダー接続時はStripe Elements等がブラウザ上で発行する不透明トークン
 * (例: Stripeの PaymentMethod ID)のみをサーバーへ渡す設計にする。
 * 現在のMockPaymentProviderは、その不透明トークンの代わりに固定のテスト用トークン文字列
 * ("mock_card_success"等)を使う。UIにも生カード番号の入力フィールドを一切設けない
 * (テストカードを選択するボタン形式。Stripeのテストカード方式を踏襲)。
 */

export interface CardDetails {
  brand: string;
  last4: string;
  expMonth: number;
  expYear: number;
}

export class PaymentDeclinedError extends Error {
  constructor(message = "カードが拒否されました。別のお支払い方法をお試しください。") {
    super(message);
    this.name = "PaymentDeclinedError";
  }
}

export interface RegisterCardInput {
  clinicId: string;
  /** 不透明なカードトークン。生のカード番号ではない(上記コメント参照)。 */
  cardToken: string;
}

export interface RegisterCardResult {
  providerCustomerId: string;
  card: CardDetails;
  requiresThreeDs: boolean;
  /** requiresThreeDs=trueの場合のみ設定される、3DS確認に必要な識別子 */
  threeDsChallengeId: string | null;
}

export interface ConfirmThreeDsInput {
  threeDsChallengeId: string;
}

export interface ConfirmThreeDsResult {
  verified: boolean;
}

export interface CreateSubscriptionInput {
  providerCustomerId: string;
  planKey: string;
  trialDays: number;
}

export interface CreateSubscriptionResult {
  providerSubscriptionId: string;
  status: "trialing";
  trialEndsAt: string; // ISO文字列
}

/**
 * カード登録→(必要なら)3Dセキュア確認→サブスクリプション作成、の3手順を提供する。
 * P0はMockPaymentProviderのみを実装する。Stripe接続はこのインターフェースの
 * 別実装(StripePaymentProvider)として後日追加し、APIルート/UIは変更しない想定。
 */
export interface PaymentProvider {
  readonly name: string;
  registerCard(input: RegisterCardInput): Promise<RegisterCardResult>;
  confirmThreeDs(input: ConfirmThreeDsInput): Promise<ConfirmThreeDsResult>;
  createSubscription(input: CreateSubscriptionInput): Promise<CreateSubscriptionResult>;
}
