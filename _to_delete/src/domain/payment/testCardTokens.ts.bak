/**
 * P0のMockPaymentProviderが受け付ける「テストカード」トークン(2026-09-06のユーザー指示)。
 * サーバー(mockPaymentProvider.ts)とクライアント(CheckoutForm.tsx)の両方から参照するため、
 * server-only依存を持たないdomain層に置く。生のカード番号ではなく、Stripeのテストカード
 * 方式を踏襲した固定トークン文字列(値に意味はなく、成功/3DS要求/拒否を切り替えるだけ)。
 */
export const TEST_CARD_TOKENS = {
  success: "mock_card_success",
  threeDsRequired: "mock_card_3ds_required",
  declined: "mock_card_declined",
} as const;

export type TestCardTokenKey = keyof typeof TEST_CARD_TOKENS;
