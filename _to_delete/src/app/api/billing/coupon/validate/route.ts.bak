import { NextRequest, NextResponse } from "next/server";
import { requireContactApi } from "@/server/auth/requireContactApi";
import { getPlanByKey } from "@/server/db/planRepository";
import { couponValidationErrorMessage, validateCoupon } from "@/server/services/validateCoupon";

export async function POST(request: NextRequest) {
  const { contact, response } = await requireContactApi();
  if (!contact) return response;

  let body: unknown;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json({ error: "リクエストボディがJSONとして解釈できません" }, { status: 400 });
  }

  const { code, planKey } = (body ?? {}) as Record<string, unknown>;
  if (typeof code !== "string" || !code.trim()) {
    return NextResponse.json({ error: "プロモコードを入力してください" }, { status: 400 });
  }
  if (typeof planKey !== "string" || !planKey) {
    return NextResponse.json({ error: "planKeyが不正です" }, { status: 400 });
  }

  const plan = await getPlanByKey(planKey);
  if (!plan) {
    return NextResponse.json({ error: "指定されたプランが見つかりません" }, { status: 404 });
  }

  // clinicIdは常にセッション(contact.clinicId)から解決する。クライアントから受け取った
  // 値を信用しない(SECURITY.mdのテナント分離方針、既存コード全体の一貫した設計)。
  const result = await validateCoupon(code, contact.clinicId, plan.priceJpy);

  if (!result.ok) {
    return NextResponse.json({ error: couponValidationErrorMessage(result.reason), reason: result.reason }, { status: 400 });
  }

  return NextResponse.json({
    couponId: result.couponId,
    code: result.code,
    percentOff: result.percentOff,
    amountOffJpy: result.amountOffJpy,
    priceBeforeDiscountJpy: result.priceBeforeDiscountJpy,
    priceAfterDiscountJpy: result.priceAfterDiscountJpy,
  });
}
