import { NextRequest, NextResponse } from "next/server";
import { requireContactApi } from "@/server/auth/requireContactApi";
import { getPlanByKey } from "@/server/db/planRepository";
import { createTrialSubscription, getSubscriptionByClinicId } from "@/server/db/subscriptionRepository";
import { getPaymentProvider } from "@/server/providers/payment/mockPaymentProvider";
import { validateCoupon } from "@/server/services/validateCoupon";

interface CardInput {
  brand: string;
  last4: string;
  expMonth: number;
  expYear: number;
}

function isCardInput(v: unknown): v is CardInput {
  if (!v || typeof v !== "object") return false;
  const c = v as Record<string, unknown>;
  return (
    typeof c.brand === "string" &&
    typeof c.last4 === "string" &&
    typeof c.expMonth === "number" &&
    typeof c.expYear === "number"
  );
}

/**
 * 契約確定エンドポイント(2026-09-06のユーザー指示の最終ステップ)。
 * プロモコードは/api/billing/coupon/validateで一度検証済みでも、ここで再検証する
 * (クライアントが提示した割引額をそのまま信用しない。二重送信・時間差での
 * 利用上限到達・重複利用にも安全)。
 */
export async function POST(request: NextRequest) {
  const { contact, response } = await requireContactApi();
  if (!contact) return response;

  const existing = await getSubscriptionByClinicId(contact.clinicId);
  if (existing) {
    return NextResponse.json({ error: "既にご契約中です" }, { status: 409 });
  }

  let body: unknown;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json({ error: "リクエストボディがJSONとして解釈できません" }, { status: 400 });
  }

  const { planKey, couponCode, providerCustomerId, card } = (body ?? {}) as Record<string, unknown>;

  if (typeof planKey !== "string" || !planKey) {
    return NextResponse.json({ error: "planKeyが不正です" }, { status: 400 });
  }
  if (typeof providerCustomerId !== "string" || !providerCustomerId) {
    return NextResponse.json({ error: "providerCustomerIdが不正です(先にカード登録を完了してください)" }, { status: 400 });
  }
  if (!isCardInput(card)) {
    return NextResponse.json({ error: "カード情報が不正です(先にカード登録を完了してください)" }, { status: 400 });
  }
  if (couponCode !== undefined && typeof couponCode !== "string") {
    return NextResponse.json({ error: "couponCodeが不正です" }, { status: 400 });
  }

  const plan = await getPlanByKey(planKey);
  if (!plan) {
    return NextResponse.json({ error: "指定されたプランが見つかりません" }, { status: 404 });
  }

  let couponId: string | null = null;
  if (typeof couponCode === "string" && couponCode.trim()) {
    const couponResult = await validateCoupon(couponCode, contact.clinicId, plan.priceJpy);
    if (!couponResult.ok) {
      return NextResponse.json({ error: "プロモコードが無効になりました。もう一度お試しください。" }, { status: 400 });
    }
    couponId = couponResult.couponId;
  }

  const providerResult = await getPaymentProvider().createSubscription({
    providerCustomerId,
    planKey: plan.key,
    trialDays: plan.trialDays,
  });

  try {
    const subscription = await createTrialSubscription({
      clinicId: contact.clinicId,
      planId: plan.id,
      couponId,
      paymentProvider: getPaymentProvider().name,
      providerCustomerId,
      providerSubscriptionId: providerResult.providerSubscriptionId,
      trialEndsAt: new Date(providerResult.trialEndsAt),
      card,
    });
    return NextResponse.json({ subscriptionId: subscription.id, status: subscription.status, trialEndsAt: subscription.trialEndsAt });
  } catch {
    // Subscription.clinicIdのユニーク制約違反(同時多重送信)を想定
    return NextResponse.json({ error: "既にご契約中です" }, { status: 409 });
  }
}
