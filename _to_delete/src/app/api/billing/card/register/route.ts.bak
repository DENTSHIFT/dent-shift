import { NextRequest, NextResponse } from "next/server";
import { requireContactApi } from "@/server/auth/requireContactApi";
import { getSubscriptionByClinicId } from "@/server/db/subscriptionRepository";
import { getPaymentProvider } from "@/server/providers/payment/mockPaymentProvider";
import { PaymentDeclinedError } from "@/server/providers/payment/types";

export async function POST(request: NextRequest) {
  const { contact, response } = await requireContactApi();
  if (!contact) return response;

  const existing = await getSubscriptionByClinicId(contact.clinicId);
  if (existing) {
    return NextResponse.json({ error: "既にご契約中です" }, { status: 409 });
  }

  let body: unknown;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json({ error: "リクエストボディがJSONとして解釈できません" }, { status: 400 });
  }

  const { cardToken } = (body ?? {}) as Record<string, unknown>;
  if (typeof cardToken !== "string" || !cardToken) {
    return NextResponse.json({ error: "cardTokenが不正です" }, { status: 400 });
  }

  try {
    const result = await getPaymentProvider().registerCard({ clinicId: contact.clinicId, cardToken });
    return NextResponse.json(result);
  } catch (e) {
    if (e instanceof PaymentDeclinedError) {
      return NextResponse.json({ error: e.message }, { status: 402 });
    }
    return NextResponse.json({ error: "カード登録に失敗しました。時間をおいて再度お試しください。" }, { status: 500 });
  }
}
