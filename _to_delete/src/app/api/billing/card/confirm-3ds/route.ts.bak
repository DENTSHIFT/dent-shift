import { NextRequest, NextResponse } from "next/server";
import { requireContactApi } from "@/server/auth/requireContactApi";
import { getPaymentProvider } from "@/server/providers/payment/mockPaymentProvider";

export async function POST(request: NextRequest) {
  const { contact, response } = await requireContactApi();
  if (!contact) return response;

  let body: unknown;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json({ error: "リクエストボディがJSONとして解釈できません" }, { status: 400 });
  }

  const { threeDsChallengeId } = (body ?? {}) as Record<string, unknown>;
  if (typeof threeDsChallengeId !== "string" || !threeDsChallengeId) {
    return NextResponse.json({ error: "threeDsChallengeIdが不正です" }, { status: 400 });
  }

  const result = await getPaymentProvider().confirmThreeDs({ threeDsChallengeId });
  if (!result.verified) {
    return NextResponse.json({ error: "3Dセキュア認証に失敗しました。もう一度お試しください。" }, { status: 402 });
  }
  return NextResponse.json(result);
}
